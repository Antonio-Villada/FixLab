# Copia a .env:  Copy-Item .env.example .env
#
# --- Orden correcto si partes SOLO de SonarQube 9.x (volumen antiguo, nunca 26.x) ---
# 1) SONARQUBE_IMAGE=sonarqube:25.12.0.117093-community
# 2) Tras migración OK → SONARQUBE_IMAGE=sonarqube:community
#
# --- Si ya arrancaste SonarQube 26.x una vez en este PC ---
# El disco de Elasticsearch ya es 8.19.x. NO vuelvas a 25.12 (rompe con "cannot downgrade").
# Deja: SONARQUBE_IMAGE=sonarqube:community
#
# --- Si community falla con "upgrade to 25.12 first" Y 25.12 falla con "cannot downgrade" ---
# Los volúmenes quedaron en un estado incompatible. Reset: docker compose down -v && docker compose up -d
#
# --- Instalación limpia (sin conservar proyectos) ---
# docker compose down -v && docker compose up -d
# (quita o comenta SONARQUBE_IMAGE para usar el default del compose)

SONARQUBE_IMAGE=sonarqube:community
