<+><div class=\"container-fluid py-4\">\n  <div class=\"d-flex justify-content-between align-items-center mb-4\">\n    <h1 class=\"h3 mb-0\">\n      <i class=\"bi bi-tags me-2\"></i>Gestión de Categorías\n    </h1>\n    <div class=\"d-flex gap-2\">\n      <a routerLink=\"/admin/productos\" class=\"btn btn-outline-secondary\">Productos</a>\n      <a routerLink=\"/admin/tipos-producto\" class=\"btn btn-outline-secondary\">Tipos de producto</a>\n      <a routerLink=\"/admin/usuarios\" class=\"btn btn-outline-secondary\">Usuarios</a>\n      <button type=\"button\" class=\"btn btn-primary\" (click)=\"openCreate()\">\n        <i class=\"bi bi-plus-lg me-1\"></i> Nueva categoría\n      </button>\n    </div>\n  </div>\n\n  @if (errorMessage()) {\n    <div class=\"alert alert-danger alert-dismissible fade show\">\n      {{ errorMessage() }}\n      <button type=\"button\" class=\"btn-close\" (click)=\"errorMessage.set(null)\"></button>\n    </div>\n  }\n\n  @if (loading()) {\n    <div class=\"text-center py-5\">\n      <div class=\"spinner-border text-primary\"></div>\n      <p class=\"mt-2 text-muted\">Cargando categorías...</p>\n    </div>\n  } @else {\n    <div class=\"table-responsive\">\n      <table class=\"table table-hover table-bordered\">\n        <thead class=\"table-dark\">\n          <tr>\n            <th>ID</th>\n            <th>Nombre</th>\n            <th style=\"width: 140px;\">Acciones</th>\n          </tr>\n        </thead>\n        <tbody>\n          @for (c of list(); track c.id) {\n            <tr>\n              <td>{{ c.id }}</td>\n              <td>{{ c.nombre }}</td>\n              <td>\n                <button type=\"button\" class=\"btn btn-sm btn-outline-primary me-1\" (click)=\"openEdit(c)\">Editar</button>\n                <button type=\"button\" class=\"btn btn-sm btn-outline-danger\" (click)=\"confirmDelete(c)\">Eliminar</button>\n              </td>\n            </tr>\n          } @empty {\n            <tr>\n              <td colspan=\"3\" class=\"text-center text-muted py-4\">No hay categorías.</td>\n            </tr>\n          }\n        </tbody>\n      </table>\n    </div>\n  }\n\n  @if (modalVisible()) {\n    <div class=\"modal show d-block\" tabindex=\"-1\" style=\"background: rgba(0,0,0,0.5);\">\n      <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n          <div class=\"modal-header\">\n            <h5 class=\"modal-title\">{{ editing() ? 'Editar categoría' : 'Nueva categoría' }}</h5>\n            <button type=\"button\" class=\"btn-close\" (click)=\"closeModal()\"></button>\n          </div>\n          <form [formGroup]=\"form\" (ngSubmit)=\"onSubmit()\">\n            <div class=\"modal-body\">\n              <label class=\"form-label\">Nombre <span class=\"text-danger\">*</span></label>\n              <input type=\"text\" formControlName=\"nombre\" class=\"form-control\" placeholder=\"Ej: Repuestos\">\n              @if (form.get('nombre')?.invalid && form.get('nombre')?.touched) {\n                <div class=\"text-danger small\">Requerido, máx. 100 caracteres.</div>\n              }\n            </div>\n            <div class=\"modal-footer\">\n              <button type=\"button\" class=\"btn btn-secondary\" (click)=\"closeModal()\">Cancelar</button>\n              <button type=\"submit\" class=\"btn btn-primary\" [disabled]=\"form.invalid\">Guardar</button>\n            </div>\n          </form>\n        </div>\n      </div>\n    </div>\n  }\n</div>\n
