<+><div class=\"container mt-4\">\n  @if (isAdmin()) {\n    <div class=\"d-flex justify-content-between align-items-center mb-4\">\n      <h2 class=\"h5 mb-0 text-muted\">Panel de administración – productos</h2>\n      <button type=\"button\" class=\"btn btn-primary\" (click)=\"openCreate()\">\n        <i class=\"bi bi-plus-lg me-1\"></i> Nuevo producto\n      </button>\n    </div>\n  }\n\n  @if (errorMessage()) {\n    <div class=\"alert alert-danger alert-dismissible fade show\">\n      {{ errorMessage() }}\n      <button type=\"button\" class=\"btn-close\" (click)=\"errorMessage.set(null)\" aria-label=\"Cerrar\"></button>\n    </div>\n  }\n\n  @if (loading()) {\n    <div class=\"text-center py-5\">\n      <div class=\"spinner-border text-primary\" role=\"status\"></div>\n      <p class=\"mt-2 text-muted\">Cargando productos...</p>\n    </div>\n  } @else {\n    <div class=\"row row-cols-1 row-cols-md-3 g-4\">\n      @for (product of productsToShow(); track product.id ?? product.sku) {\n        <div class=\"col\">\n          <div class=\"card h-100 shadow-sm border-0\">\n            @if (product.imagenUrl) {\n              <img [src]=\"product.imagenUrl\" class=\"card-img-top\" [alt]=\"product.nombre\" style=\"height: 200px; object-fit: contain; padding: 10px;\">\n            } @else {\n              <div class=\"bg-light text-center py-5\">Sin imagen</div>\n            }\n\n            <div class=\"card-body\">\n              <h5 class=\"card-title fw-bold\">{{ product.nombre }}</h5>\n              @if (product.categoria || product.tipoProducto) {\n                <p class=\"card-text text-muted small mb-1\">\n                  @if (product.categoria) {\n                    <span class=\"me-2\">{{ product.categoria.nombre }}</span>\n                  }\n                  @if (product.tipoProducto) {\n                    <span>{{ product.tipoProducto.nombre }}</span>\n                  }\n                </p>\n              }\n              <p class=\"card-text text-muted small text-truncate\">{{ product.descripcion }}</p>\n              <p class=\"fs-4 fw-bold text-primary mb-0\">${{ product.precio | number:'1.2-2' }}</p>\n              <small class=\"text-muted\">Stock: {{ product.stock }}</small>\n              @if (isAdmin()) {\n                <div class=\"mt-2\">\n                  @if (product.activo !== false) {\n                    <span class=\"badge bg-success\">Activo</span>\n                  } @else {\n                    <span class=\"badge bg-secondary\">Inactivo</span>\n                  }\n                </div>\n              }\n            </div>\n\n            <div class=\"card-footer bg-transparent border-top-0 pb-3\">\n              @if (isAdmin()) {\n                <div class=\"d-flex gap-2\">\n                  <button type=\"button\" class=\"btn btn-outline-primary flex-grow-1\" (click)=\"openEdit(product)\">\n                    <i class=\"bi bi-pencil me-1\"></i> Editar\n                  </button>\n                  <button type=\"button\" class=\"btn btn-outline-danger\" (click)=\"confirmDelete(product)\" title=\"Desactivar\">\n                    <i class=\"bi bi-trash\"></i>\n                  </button>\n                </div>\n              } @else {\n                <div class=\"d-flex gap-2\">\n                  <button type=\"button\" class=\"btn btn-outline-primary flex-grow-1\">Ver detalles</button>\n                  <button type=\"button\" class=\"btn btn-primary\" title=\"Agregar al carrito\" (click)=\"addToCart(product)\">\n                    <i class=\"bi bi-cart-plus fs-5\"></i>\n                  </button>\n                </div>\n              }\n            </div>\n          </div>\n        </div>\n      } @empty {\n        <div class=\"col-12 text-center\">\n          <div class=\"alert alert-info py-5\">\n            <i class=\"bi bi-search fs-1 d-block mb-3\"></i>\n            No hay productos disponibles.\n            @if (isAdmin()) {\n              <p class=\"mb-0 mt-2\">Crea uno con <strong>Nuevo producto</strong>.</p>\n            }\n          </div>\n        </div>\n      }\n    </div>\n  }\n\n  <!-- Modal Crear/Editar producto (solo admin) -->\n  @if (modalVisible()) {\n    <div class=\"modal show d-block\" tabindex=\"-1\" style=\"background: rgba(0,0,0,0.5);\">\n      <div class=\"modal-dialog modal-dialog-centered modal-lg\">\n        <div class=\"modal-content\">\n          <div class=\"modal-header\">\n            <h5 class=\"modal-title\">{{ isEditing() ? 'Editar producto' : 'Nuevo producto' }}</h5>\n            <button type=\"button\" class=\"btn-close\" (click)=\"closeModal()\" aria-label=\"Cerrar\"></button>\n          </div>\n          <form [formGroup]=\"form\" (ngSubmit)=\"onSubmit()\">\n            <div class=\"modal-body\">\n              <div class=\"row\">\n                <div class=\"col-md-6\">\n                  <div class=\"mb-3\">\n                    <label class=\"form-label\">SKU <span class=\"text-danger\">*</span></label>\n                    <input type=\"text\" formControlName=\"sku\" class=\"form-control\" placeholder=\"Ej: LAP-001\" [readonly]=\"isEditing()\">\n                    @if (form.get('sku')?.invalid && form.get('sku')?.touched) {\n                      <div class=\"text-danger small\">Requerido, máx. 50 caracteres.</div>\n                    }\n                  </div>\n                  <div class=\"mb-3\">\n                    <label class=\"form-label\">Nombre <span class=\"text-danger\">*</span></label>\n                    <input type=\"text\" formControlName=\"nombre\" class=\"form-control\" placeholder=\"Nombre del producto\">\n                    @if (form.get('nombre')?.invalid && form.get('nombre')?.touched) {\n                      <div class=\"text-danger small\">Requerido, máx. 150 caracteres.</div>\n                    }\n                  </div>\n                  <div class=\"mb-3\">\n                    <label class=\"form-label\">Categoría <span class=\"text-danger\">*</span></label>\n                    <select formControlName=\"categoriaId\" class=\"form-select\">\n                      <option [ngValue]=\"null\">Seleccione categoría</option>\n                      @for (c of categorias(); track c.id) {\n                        <option [ngValue]=\"c.id\">{{ c.nombre }}</option>\n                      }\n                    </select>\n                    @if (form.get('categoriaId')?.invalid && form.get('categoriaId')?.touched) {\n                      <div class=\"text-danger small\">Seleccione una categoría.</div>\n                    }\n                  </div>\n                  <div class=\"mb-3\">\n                    <label class=\"form-label\">Tipo de producto <span class=\"text-danger\">*</span></label>\n                    <select formControlName=\"tipoProductoId\" class=\"form-select\">\n                      <option [ngValue]=\"null\">Seleccione tipo</option>\n                      @for (t of tiposProducto(); track t.id) {\n                        <option [ngValue]=\"t.id\">{{ t.nombre }}</option>\n                      }\n                    </select>\n                    @if (form.get('tipoProductoId')?.invalid && form.get('tipoProductoId')?.touched) {\n                      <div class=\"text-danger small\">Seleccione un tipo de producto.</div>\n                    }\n                  </div>\n                  <div class=\"mb-3\">\n                    <label class=\"form-label\">Descripción</label>\n                    <textarea formControlName=\"descripcion\" class=\"form-control\" rows=\"2\" placeholder=\"Opcional\"></textarea>\n                  </div>\n                  <div class=\"row g-2\">\n                    <div class=\"col-6\">\n                      <label class=\"form-label\">Precio <span class=\"text-danger\">*</span></label>\n                      <input type=\"number\" formControlName=\"precio\" class=\"form-control\" min=\"0\" step=\"0.01\">\n                    </div>\n                    <div class=\"col-6\">\n                      <label class=\"form-label\">Stock <span class=\"text-danger\">*</span></label>\n                      <input type=\"number\" formControlName=\"stock\" class=\"form-control\" min=\"0\">\n                    </div>\n                  </div>\n                  <div class=\"mb-3 mt-2\">\n                    <label class=\"form-label\">URL de imagen</label>\n                    <input type=\"url\" formControlName=\"imagenUrl\" class=\"form-control\" placeholder=\"https://... (opcional)\"\n                      (input)=\"onImagenUrlChange()\">\n                  </div>\n                  <div class=\"mb-3\">\n                    <label class=\"form-label\">Imagen del producto</label>\n                    <input type=\"file\" class=\"form-control\" accept=\"image/*\" (change)=\"onFileSelected($event)\">\n                    @if (isEditing()) {\n                      <small class=\"text-muted\">Opcional al editar: sube otra imagen para reemplazar.</small>\n                    } @else {\n                      <small class=\"text-warning d-block mt-1\">Requerido al crear.</small>\n                    }\n                    @if (selectedFile()) {\n                      <button type=\"button\" class=\"btn btn-sm btn-outline-secondary mt-2\" (click)=\"removeSelectedImage()\">Quitar imagen seleccionada</button>\n                    }\n                  </div>\n                </div>\n                <div class=\"col-md-6 d-flex flex-column align-items-center justify-content-center\">\n                  <label class=\"form-label w-100 text-center\">Vista previa</label>\n                  @if (imagePreviewUrl()) {\n                    <img [src]=\"imagePreviewUrl()\" alt=\"Vista previa\" class=\"img-fluid rounded border\" style=\"max-height: 280px; object-fit: contain;\">\n                  } @else {\n                    <div class=\"bg-light rounded border d-flex align-items-center justify-content-center text-muted\" style=\"height: 200px; width: 100%; max-width: 280px;\">\n                      Sin imagen\n                    </div>\n                  }\n                </div>\n              </div>\n            </div>\n            <div class=\"modal-footer\">\n              <button type=\"button\" class=\"btn btn-secondary\" (click)=\"closeModal()\">Cancelar</button>\n              <button type=\"submit\" class=\"btn btn-primary\" [disabled]=\"form.invalid || uploadingImage()\">\n                @if (uploadingImage()) {\n                  <span class=\"spinner-border spinner-border-sm me-1\"></span>\n                }\n                {{ isEditing() ? 'Guardar cambios' : 'Crear producto' }}\n              </button>\n            </div>\n          </form>\n        </div>\n      </div>\n    </div>\n  }\n</div>\n
