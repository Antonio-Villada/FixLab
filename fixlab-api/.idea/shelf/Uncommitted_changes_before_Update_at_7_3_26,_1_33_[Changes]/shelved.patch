<+><div class=\"container-fluid py-4\">\n  <div class=\"d-flex justify-content-between align-items-center mb-4\">\n    <h1 class=\"h3 mb-0\">\n      <i class=\"bi bi-box-seam me-2\"></i>Gestión de Productos\n    </h1>\n    <div class=\"d-flex gap-2\">\n      <a routerLink=\"/admin/categorias\" class=\"btn btn-outline-secondary\">Categorías</a>\n      <a routerLink=\"/admin/tipos-producto\" class=\"btn btn-outline-secondary\">Tipos de producto</a>\n      <a routerLink=\"/admin/usuarios\" class=\"btn btn-outline-secondary\">Usuarios</a>\n      <button type=\"button\" class=\"btn btn-primary\" (click)=\"openCreate()\">\n        <i class=\"bi bi-plus-lg me-1\"></i> Nuevo producto\n      </button>\n    </div>\n  </div>\n\n  @if (errorMessage()) {\n    <div class=\"alert alert-danger alert-dismissible fade show\" role=\"alert\">\n      {{ errorMessage() }}\n      <button type=\"button\" class=\"btn-close\" (click)=\"errorMessage.set(null)\" aria-label=\"Cerrar\"></button>\n    </div>\n  }\n\n  @if (loading()) {\n    <div class=\"text-center py-5\">\n      <div class=\"spinner-border text-primary\" role=\"status\"></div>\n      <p class=\"mt-2 text-muted\">Cargando productos...</p>\n    </div>\n  } @else {\n    <div class=\"table-responsive\">\n      <table class=\"table table-hover table-bordered align-middle\">\n        <thead class=\"table-dark\">\n          <tr>\n            <th>SKU</th>\n            <th>Nombre</th>\n            <th>Categoría</th>\n            <th>Tipo</th>\n            <th>Precio</th>\n            <th>Stock</th>\n            <th>Activo</th>\n            <th style=\"width: 140px;\">Acciones</th>\n          </tr>\n        </thead>\n        <tbody>\n          @for (p of products(); track p.id ?? p.sku) {\n            <tr>\n              <td><code>{{ p.sku }}</code></td>\n              <td>{{ p.nombre }}</td>\n              <td>{{ p.categoria?.nombre ?? '-' }}</td>\n              <td>{{ p.tipoProducto?.nombre ?? '-' }}</td>\n              <td>${{ p.precio | number:'1.2-2' }}</td>\n              <td>{{ p.stock }}</td>\n              <td>\n                @if (p.activo !== false) {\n                  <span class=\"badge bg-success\">Sí</span>\n                } @else {\n                  <span class=\"badge bg-secondary\">No</span>\n                }\n              </td>\n              <td>\n                <button type=\"button\" class=\"btn btn-sm btn-outline-primary me-1\" (click)=\"openEdit(p)\" title=\"Editar\">\n                  <i class=\"bi bi-pencil\"></i>\n                </button>\n                <button type=\"button\" class=\"btn btn-sm btn-outline-danger\" (click)=\"confirmDelete(p)\" title=\"Desactivar\">\n                  <i class=\"bi bi-trash\"></i>\n                </button>\n              </td>\n            </tr>\n          } @empty {\n            <tr>\n              <td colspan=\"8\" class=\"text-center text-muted py-4\">No hay productos. Crea uno con \"Nuevo producto\".</td>\n            </tr>\n          }\n        </tbody>\n      </table>\n    </div>\n  }\n\n  <!-- Modal Crear/Editar -->\n  @if (modalVisible()) {\n    <div class=\"modal show d-block\" tabindex=\"-1\" role=\"dialog\" style=\"background: rgba(0,0,0,0.5);\">\n      <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n          <div class=\"modal-header\">\n            <h5 class=\"modal-title\">{{ isEditing() ? 'Editar producto' : 'Nuevo producto' }}</h5>\n            <button type=\"button\" class=\"btn-close\" (click)=\"closeModal()\" aria-label=\"Cerrar\"></button>\n          </div>\n          <form [formGroup]=\"form\" (ngSubmit)=\"onSubmit()\">\n            <div class=\"modal-body\">\n              <div class=\"mb-3\">\n                <label class=\"form-label\">SKU <span class=\"text-danger\">*</span></label>\n                <input type=\"text\" formControlName=\"sku\" class=\"form-control\" placeholder=\"Ej: LAP-001\"\n                  [readonly]=\"isEditing()\">\n                @if (form.get('sku')?.invalid && form.get('sku')?.touched) {\n                  <div class=\"text-danger small\">SKU requerido, máx. 50 caracteres.</div>\n                }\n              </div>\n              <div class=\"mb-3\">\n                <label class=\"form-label\">Nombre <span class=\"text-danger\">*</span></label>\n                <input type=\"text\" formControlName=\"nombre\" class=\"form-control\" placeholder=\"Nombre del producto\">\n                @if (form.get('nombre')?.invalid && form.get('nombre')?.touched) {\n                  <div class=\"text-danger small\">Nombre requerido, máx. 150 caracteres.</div>\n                }\n              </div>\n              <div class=\"mb-3\">\n                <label class=\"form-label\">Categoría <span class=\"text-danger\">*</span></label>\n                <select formControlName=\"categoriaId\" class=\"form-select\">\n                  <option [ngValue]=\"null\">Seleccione categoría</option>\n                  @for (c of categorias(); track c.id) {\n                    <option [ngValue]=\"c.id\">{{ c.nombre }}</option>\n                  }\n                </select>\n                @if (form.get('categoriaId')?.invalid && form.get('categoriaId')?.touched) {\n                  <div class=\"text-danger small\">Seleccione una categoría.</div>\n                }\n              </div>\n              <div class=\"mb-3\">\n                <label class=\"form-label\">Tipo de producto <span class=\"text-danger\">*</span></label>\n                <select formControlName=\"tipoProductoId\" class=\"form-select\">\n                  <option [ngValue]=\"null\">Seleccione tipo</option>\n                  @for (t of tiposProducto(); track t.id) {\n                    <option [ngValue]=\"t.id\">{{ t.nombre }}</option>\n                  }\n                </select>\n                @if (form.get('tipoProductoId')?.invalid && form.get('tipoProductoId')?.touched) {\n                  <div class=\"text-danger small\">Seleccione un tipo de producto.</div>\n                }\n              </div>\n              <div class=\"mb-3\">\n                <label class=\"form-label\">Descripción</label>\n                <textarea formControlName=\"descripcion\" class=\"form-control\" rows=\"2\"\n                  placeholder=\"Descripción opcional\"></textarea>\n              </div>\n              <div class=\"row g-2\">\n                <div class=\"col-6\">\n                  <label class=\"form-label\">Precio <span class=\"text-danger\">*</span></label>\n                  <input type=\"number\" formControlName=\"precio\" class=\"form-control\" min=\"0\" step=\"0.01\">\n                  @if (form.get('precio')?.invalid && form.get('precio')?.touched) {\n                    <div class=\"text-danger small\">Precio &ge; 0.</div>\n                  }\n                </div>\n                <div class=\"col-6\">\n                  <label class=\"form-label\">Stock <span class=\"text-danger\">*</span></label>\n                  <input type=\"number\" formControlName=\"stock\" class=\"form-control\" min=\"0\">\n                  @if (form.get('stock')?.invalid && form.get('stock')?.touched) {\n                    <div class=\"text-danger small\">Stock &ge; 0.</div>\n                  }\n                </div>\n              </div>\n              <div class=\"mb-3 mt-2\">\n                <label class=\"form-label\">URL imagen</label>\n                <input type=\"url\" formControlName=\"imagenUrl\" class=\"form-control\"\n                  placeholder=\"(Opcional; al editar se usa la subida si envías archivo)\">\n              </div>\n              @if (!isEditing()) {\n                <div class=\"mb-3\">\n                  <label class=\"form-label\">Imagen del producto <span class=\"text-danger\">*</span></label>\n                  <input type=\"file\" class=\"form-control\" accept=\"image/*\" (change)=\"onFileSelected($event)\">\n                  <small class=\"text-muted\">Requerido al crear. Se sube a Cloudinary.</small>\n                </div>\n              } @else {\n                <div class=\"mb-3\">\n                  <label class=\"form-label\">Nueva imagen (opcional)</label>\n                  <input type=\"file\" class=\"form-control\" accept=\"image/*\" (change)=\"onFileSelected($event)\">\n                  <small class=\"text-muted\">Dejar vacío para mantener la imagen actual.</small>\n                </div>\n              }\n            </div>\n            <div class=\"modal-footer\">\n              <button type=\"button\" class=\"btn btn-secondary\" (click)=\"closeModal()\">Cancelar</button>\n              <button type=\"submit\" class=\"btn btn-primary\"\n                [disabled]=\"form.invalid || (!isEditing() && !selectedFile()) || uploadingImage()\">\n                @if (uploadingImage()) {\n                  <span class=\"spinner-border spinner-border-sm me-1\"></span>\n                }\n                {{ isEditing() ? 'Guardar cambios' : 'Crear producto' }}\n              </button>\n            </div>\n          </form>\n        </div>\n      </div>\n    </div>\n  }\n</div>\n
