td>\n              <td>{{ u.correoVerificado ? 'Sí' : 'No' }}</td>\n              <td>\n                <button type=\"button\" class=\"btn btn-sm btn-outline-primary me-1\" (click)=\"openEdit(u)\">Editar</button>\n                <button type=\"button\" class=\"btn btn-sm btn-outline-info me-1\" (click)=\"openChangeRol(u)\">Cambiar rol</button>\n                <button type=\"button\" class=\"btn btn-sm btn-outline-danger\" (click)=\"confirmDelete(u)\">Eliminar</button>\n              </td>\n            </tr>\n          } @empty {\n            <tr>\n              <td colspan=\"8\" class=\"text-center text-muted py-4\">No hay usuarios.</td>\n            </tr>\n          }\n        </tbody>\n      </table>\n    </div>\n  }\n\n  <!-- Modal Crear empleado -->\n  @if (modalVisible() && !editing()) {\n    <div class=\"modal show d-block\" tabindex=\"-1\" style=\"background: rgba(0,0,0,0.5);\">\n      <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n          <div class=\"modal-header\">\n            <h5 class=\"modal-title\">Nuevo empleado (ADMIN o TÉCNICO)</h5>\n            <button type=\"button\" class=\"btn-close\" (click)=\"closeModal()\"></button>\n          </div>\n          <form [formGroup]=\"formNewEmployee\" (ngSubmit)=\"onSubmitNewEmployee()\">\n            <div class=\"modal-body\">\n              <div class=\"mb-2\">\n                <label class=\"form-label\">Cédula <span class=\"text-danger\">*</span></label>\n                <input type=\"text\" formControlName=\"cedula\" class=\"form-control\" placeholder=\"Ej: 1234567890\">\n              </div>\n              <div class=\"row g-2\">\n                <div class=\"col-6\">\n                  <label class=\"form-label\">Nombre <span class=\"text-danger\">*</span></label>\n                  <input type=\"text\" formControlName=\"nombre\" class=\"form-control\">\n                </div>\n                <div class=\"col-6\">\n                  <label class=\"form-label\">Apellido <span class=\"text-danger\">*</span></label>\n                  <input type=\"text\" formControlName=\"apellido\" class=\"form-control\">\n                </div>\n              </div>\n              <div class=\"mb-2 mt-2\">\n                <label class=\"form-label\">Email <span class=\"text-danger\">*</span></label>\n                <input type=\"email\" formControlName=\"email\" class=\"form-control\">\n              </div>\n              <div class=\"mb-2\">\n                <label class=\"form-label\">Contraseña <span class=\"text-danger\">*</span></label>\n                <input type=\"password\" formControlName=\"password\" class=\"form-control\" placeholder=\"Mín. 6 caracteres\">\n              </div>\n              <div class=\"mb-2\">\n                <label class=\"form-label\">Teléfono</label>\n                <input type=\"text\" formControlName=\"telefono\" class=\"form-control\">\n              </div>\n              <div class=\"mb-2\">\n                <label class=\"form-label\">Rol <span class=\"text-danger\">*</span></label>\n                <select formControlName=\"rol\" class=\"form-select\">\n                  <option [ngValue]=\"ROLES[0]\">Administrador</option>\n                  <option [ngValue]=\"ROLES[1]\">Técnico</option>\n                </select>\n              </div>\n            </div>\n            <div class=\"modal-footer\">\n              <button type=\"button\" class=\"btn btn-secondary\" (click)=\"closeModal()\">Cancelar</button>\n              <button type=\"submit\" class=\"btn btn-primary\" [disabled]=\"formNewEmployee.invalid\">Crear empleado</button>\n            </div>\n          </form>\n        </div>\n      </div>\n    </div>\n  }\n\n  <!-- Modal Editar usuario -->\n  @if (modalVisible() && editing() && !modalRolVisible()) {\n    <div class=\"modal show d-block\" tabindex=\"-1\" style=\"background: rgba(0,0,0,0.5);\">\n      <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n          <div class=\"modal-header\">\n            <h5 class=\"modal-title\">Editar usuario</h5>\n            <button type=\"button\" class=\"btn-close\" (click)=\"closeModal()\"></button>\n          </div>\n          <form [formGroup]=\"formEdit\" (ngSubmit)=\"onSubmitEdit()\">\n            <div class=\"modal-body\">\n              <div class=\"mb-2\">\n                <label class=\"form-label\">Nombre <span class=\"text-danger\">*</span></label>\n                <input type=\"text\" formControlName=\"nombre\" class=\"form-control\">\n              </div>\n              <div class=\"mb-2\">\n                <label class=\"form-label\">Apellido <span class=\"text-danger\">*</span></label>\n                <input type=\"text\" formControlName=\"apellido\" class=\"form-control\">\n              </div>\n              <div class=\"mb-2\">\n                <label class=\"form-label\">Teléfono</label>\n                <input type=\"text\" formControlName=\"telefono\" class=\"form-control\">\n              </div>\n            </div>\n            <div class=\"modal-footer\">\n              <button type=\"button\" class=\"btn btn-secondary\" (click)=\"closeModal()\">Cancelar</button>\n              <button type=\"submit\" class=\"btn btn-primary\" [disabled]=\"formEdit.invalid\">Guardar</button>\n            </div>\n          </form>\n        </div>\n      </div>\n    </div>\n  }\n\n  <!-- Modal Cambiar rol -->\n  @if (modalRolVisible()) {\n    <div class=\"modal show d-block\" tabindex=\"-1\" style=\"background: rgba(0,0,0,0.5);\">\n      <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n          <div class=\"modal-header\">\n            <h5 class=\"modal-title\">Cambiar rol de usuario</h5>\n            <button type=\"button\" class=\"btn-close\" (click)=\"closeModal()\"></button>\n          </div>\n          <form [formGroup]=\"formRol\" (ngSubmit)=\"onSubmitRol()\">\n            <div class=\"modal-body\">\n              <label class=\"form-label\">Nuevo rol</label>\n              <select formControlName=\"nuevoRol\" class=\"form-select\">\n                @for (r of ROLES; track r) {\n                  <option [ngValue]=\"r\">{{ rolLabel(r) }}</option>\n                }\n              </select>\n            </div>\n            <div class=\"modal-footer\">\n              <button type=\"button\" class=\"btn btn-secondary\" (click)=\"closeModal()\">Cancelar</button>\n              <button type=\"submit\" class=\"btn btn-primary\" [disabled]=\"formRol.invalid\">Cambiar rol</button>\n            </div>\n          </form>\n        </div>\n      </div>\n    </div>\n  }\n</div>\n
