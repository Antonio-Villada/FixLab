l\" formControlName=\"telefono\" placeholder=\"Ej: 3001234567\" />\n            @if (registroForm.get('telefono')?.invalid && registroForm.get('telefono')?.touched) {\n              <span class=\"error\">Números, 7-20 dígitos.</span>\n            }\n          </div>\n        </div>\n\n        <div class=\"form-group\">\n          <label for=\"email\">Correo electrónico</label>\n          <input id=\"email\" type=\"email\" formControlName=\"email\" placeholder=\"correo@ejemplo.com\" autocomplete=\"email\" />\n          @if (registroForm.get('email')?.invalid && registroForm.get('email')?.touched) {\n            <span class=\"error\">Correo válido requerido.</span>\n          }\n        </div>\n\n        <div class=\"form-row\">\n          <div class=\"form-group\">\n            <label for=\"password\">Contraseña</label>\n            <input id=\"password\" type=\"password\" formControlName=\"password\" placeholder=\"Mín. 8 caracteres, letras y números\" autocomplete=\"new-password\" />\n            @if (registroForm.get('password')?.invalid && registroForm.get('password')?.touched) {\n              <span class=\"error\">Mín. 8 caracteres, letras y números.</span>\n            }\n          </div>\n          <div class=\"form-group\">\n            <label for=\"confirmPassword\">Confirmar contraseña</label>\n            <input id=\"confirmPassword\" type=\"password\" formControlName=\"confirmPassword\" placeholder=\"Repite la contraseña\" autocomplete=\"new-password\" />\n            @if (registroForm.get('confirmPassword')?.invalid && registroForm.get('confirmPassword')?.touched) {\n              <span class=\"error\">Requerido.</span>\n            }\n            @if (registroForm.errors?.['passwordMismatch'] && registroForm.get('confirmPassword')?.touched) {\n              <span class=\"error\">Las contraseñas no coinciden.</span>\n            }\n          </div>\n        </div>\n\n        <div class=\"form-group terms-group\">\n          <label class=\"terms-label\">\