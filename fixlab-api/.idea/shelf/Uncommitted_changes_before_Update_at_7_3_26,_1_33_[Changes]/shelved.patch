<+>/* Página de registro - diseño tipo imagen: split layout y gradiente */\n\n.register-page {\n  min-height: 100vh;\n  background: linear-gradient(135deg, #7dd3a8 0%, #4db8a8 40%, #2d8b9e 70%, #1a6b7a 100%);\n  background-attachment: fixed;\n  position: relative;\n  overflow-x: hidden;\n}\n\n.register-page::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background-image:\n    radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.08) 0%, transparent 50%),\n    radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.06) 0%, transparent 50%);\n  pointer-events: none;\n}\n\n.register-container {\n  display: grid;\n  grid-template-columns: 1.2fr 0.8fr;\n  min-height: 100vh;\n  max-width: 1200px;\n  margin: 0 auto;\n  position: relative;\n  z-index: 1;\n}\n\n@media (max-width: 900px) {\n  .register-container {\n    grid-template-columns: 1fr;\n  }\n  .promo-panel {\n    display: none;\n  }\n}\n\n/* Panel izquierdo: formulario */\n.form-panel {\n  padding: 2.5rem 3rem 2rem;\n  display: flex;\n  flex-direction: column;\n  color: #fff;\n}\n\n.form-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 2rem;\n}\n\n.brand {\n  font-size: 1.25rem;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n}\n\n.sign-in-link {\n  color: #fff;\n  text-decoration: none;\n  font-size: 0.9rem;\n  opacity: 0.95;\n}\n\n.sign-in-link strong {\n  color: #a8e6cf;\n  text-decoration: underline;\n}\n\n.sign-in-link:hover {\n  opacity: 1;\n}\n\n.sign-in-link:hover strong {\n  color: #d4f5e4;\n}\n\n.form-title {\n  font-size: 2rem;\n  font-weight: 700;\n  margin: 0 0 1.75rem 0;\n  letter-spacing: -0.02em;\n}\n\n.register-form {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  max-width: 520px;\n}\n\n.form-row {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 1rem;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n}\n\n.form-group label {\n  font-size: 0.875rem;\n  font-weight: 600;\n}\n\n.form-group input[type=\"text\"],\n.form-group input[type=\"email\"],\n.form-group input[type=\"tel\"],\n.form-group input[type=\"password\"] {\n  padding: 0.65rem 0.85rem;\n  border: none;\n  border-radius: 6px;\n  font-size: 0.95rem;\n  background: #fff;\n  color: #1a1a1a;\n}\n\n.form-group input::placeholder {\n  color: #888;\n}\n\n.form-group .error {\n  font-size: 0.8rem;\n  color: #ffcccb;\n}\n\n.terms-group {\n  margin-top: 0.25rem;\n}\n\n.terms-label {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.6rem;\n  cursor: pointer;\n  font-size: 0.9rem;\n  font-weight: 400;\n}\n\n.terms-label input[type=\"checkbox\"] {\n  margin-top: 0.2rem;\n  width: 1.1rem;\n  height: 1.1rem;\n  accent-color: #1a4d5c;\n}\n\n.terms-label strong {\n  color: #a8e6cf;\n  text-decoration: underline;\n}\n\n.btn-create {\n  margin-top: 0.5rem;\n  padding: 0.85rem 1.5rem;\n  background: #1a4d5c;\n  color: #fff;\n  border: none;\n  border-radius: 6px;\n  font-size: 1rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: background 0.2s;\n}\n\n.btn-create:hover:not(:disabled) {\n  background: #234d5c;\n}\n\n.btn-create:disabled {\n  opacity: 0.7;\n  cursor: not-allowed;\n}\n\n.footer-copy {\n  margin-top: 1.5rem;\n  font-size: 0.75rem;\n  opacity: 0.85;\n}\n\n/* Panel derecho: logo FixLab */\n.promo-panel {\n  padding: 2.5rem 2rem;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.logo-wrap {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n}\n\n.logo-image {\n  max-width: 100%;\n  max-height: 280px;\n  width: auto;\n  height: auto;\n  object-fit: contain;\n}\n
